---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const åbningstider = [
  { dag: 'Mandag', tid: '8-18' },
  { dag: 'Tirsdag', tid: '8-18' },
  { dag: 'Onsdag', tid: '8-18' },
  { dag: 'Torsdag', tid: '8-18' },
  { dag: 'Fredag', tid: '8-18' },
  { dag: 'Lørdag', tid: '9-14' },
  { dag: 'Søndag', tid: 'Lukket' },
];
---

<Layout title="Kontakt IC Køreskole i Randers">
  <Nav />

  <!-- HERO -->
  <section class="bg-gradient-to-b from-[var(--color-brand-50)] to-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-brand-500)] mb-6">
        Kontakt os
      </h1>
      <p class="text-lg text-[var(--color-ink-700)] max-w-2xl mx-auto">
        Ring, skriv eller besøg os. Vi svarer inden for 24 timer på hverdage.
      </p>
    </div>
  </section>

  <!-- KONTAKT + FORMULAR -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="grid md:grid-cols-2 gap-12">

      <!-- VENSTRE: KONTAKTINFO -->
      <div>
        <h2 class="text-2xl font-extrabold mb-6 text-[var(--color-brand-500)]">
          Kontaktinformation
        </h2>

        <div class="space-y-5 mb-10">
          <div class="flex items-start gap-4">
            <div class="text-2xl shrink-0">📞</div>
            <div>
              <p class="font-semibold mb-1">Telefon</p>
              <a href="tel:+45XXXXXXXX" class="text-[var(--color-ink-700)] hover:text-[var(--color-brand-500)]">
                [telefonnummer]
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-2xl shrink-0">✉️</div>
            <div>
              <p class="font-semibold mb-1">Email</p>
              <a href="mailto:info@ickoreskole.dk" class="text-[var(--color-ink-700)] hover:text-[var(--color-brand-500)]">
                info@ickoreskole.dk
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-2xl shrink-0">📍</div>
            <div>
              <p class="font-semibold mb-1">Adresse</p>
              <p class="text-[var(--color-ink-700)]">
                [Adresse]<br />
                8900 Randers
              </p>
            </div>
          </div>
        </div>

        <!-- ÅBNINGSTIDER -->
        <h2 class="text-2xl font-extrabold mb-4 text-[var(--color-brand-500)]">
          Åbningstider
        </h2>
        <div class="bg-white border-2 border-gray-100 rounded-2xl overflow-hidden">
          <table class="w-full text-sm">
            <tbody>
              {åbningstider.map((a, i) => (
                <tr class:list={['border-b border-gray-100 last:border-0', a.tid === 'Lukket' && 'text-[var(--color-ink-500)]']}>
                  <td class="p-3 font-medium">{a.dag}</td>
                  <td class="p-3 text-right">{a.tid}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- SOME -->
        <h2 class="text-2xl font-extrabold mt-10 mb-4 text-[var(--color-brand-500)]">
          Følg os
        </h2>
        <div class="flex gap-3">
          <a href="#" class="btn btn-secondary text-sm">Instagram</a>
          <a href="#" class="btn btn-secondary text-sm">Facebook</a>
          <a href="#" class="btn btn-secondary text-sm">TikTok</a>
        </div>
      </div>

      <!-- HØJRE: FORMULAR -->
      <div>
        <h2 class="text-2xl font-extrabold mb-6 text-[var(--color-brand-500)]">
          Send os en besked
        </h2>

        <!-- Formularen er klar til at blive koblet på Tally/Formspree senere -->
        <form
  name="kontakt"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="bg-white border-2 border-gray-100 rounded-2xl p-6 space-y-5"
>
  <input type="hidden" name="form-name" value="kontakt" />
  <p class="hidden">
    <label>Udfyld ikke dette felt: <input name="bot-field" /></label>
  </p>
  <!-- resten af dine felter her -->
</form>

        <p class="text-xs text-center text-[var(--color-ink-500)] mt-4">
          Vi vender tilbage inden for 24 timer på hverdage.
        </p>
      </div>
    </div>
  </section>

  <!-- GOOGLE MAPS -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <h2 class="text-2xl font-extrabold mb-6 text-[var(--color-brand-500)]">
      Find os
    </h2>
    <div class="bg-[var(--color-brand-50)] border-2 border-gray-100 rounded-2xl aspect-video flex items-center justify-center">
      <!--
        ═══════════════════════════════════════════════════════════
        GOOGLE MAPS EMBED — PLACEHOLDER

        Når du er klar:
        1. Gå til maps.google.com
        2. Søg efter din adresse
        3. Klik "Del" → "Integrer et kort"
        4. Kopier iframe-koden
        5. Erstat denne placeholder med iframe-koden

        Eksempel:
        <iframe src="https://www.google.com/maps/embed?..." 
                width="100%" height="100%" 
                style="border:0;" loading="lazy"></iframe>
        ═══════════════════════════════════════════════════════════
      -->
      <div class="text-center p-8">
        <div class="text-5xl mb-3">🗺️</div>
        <p class="text-[var(--color-ink-700)] font-medium">Kort vises her</p>
        <p class="text-xs text-[var(--color-ink-500)] mt-2">
          [Adresse], 8900 Randers
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>