<form
  name="kontakt"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="bg-white border-2 border-gray-100 rounded-2xl p-6 space-y-5"
>
  <input type="hidden" name="form-name" value="kontakt" />

  <p style="display: none;">
    <label>Udfyld ikke dette felt: <input name="bot-field" /></label>
  </p>

  <div>
    <label for="navn" class="block text-sm font-semibold mb-2">Navn *</label>
    <input
      type="text"
      id="navn"
      name="navn"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-semibold mb-2">Email *</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    />
  </div>

  <div>
    <label for="telefon" class="block text-sm font-semibold mb-2">Telefon (valgfrit)</label>
    <input
      type="tel"
      id="telefon"
      name="telefon"
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    />
  </div>

  <div>
    <label for="besked" class="block text-sm font-semibold mb-2">Besked *</label>
    <textarea
      id="besked"
      name="besked"
      rows="5"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    ></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm">
    <input type="checkbox" name="samtykke" required class="mt-1" />
    <span class="text-[var(--color-ink-700)]">
      Jeg accepterer, at IC Køreskole må kontakte mig angående min henvendelse. Se
      <a href="#" class="underline">privatlivspolitik</a>.
    </span>
  </label>

  <button type="submit" class="btn btn-primary w-full text-base py-3">
    Send besked
  </button>
</form>