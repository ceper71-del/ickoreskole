---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { hold } from '../data/hold.js';

const pakker = [
  {
    navn: 'Basis',
    pris: '8.995',
    beskrivelse: 'Til dig, der vil tage kørekortet i dit eget tempo.',
    features: ['Lovpligtig teori (29 lektioner)', '8 køretimer', 'Manøvrebane', 'Glatbane', 'Teoriprøve booking'],
    anbefalet: false,
  },
  {
    navn: 'Anbefalet',
    pris: '11.995',
    beskrivelse: 'Vores mest populære pakke. De fleste elever vælger denne.',
    features: ['Lovpligtig teori (29 lektioner)', '12 køretimer', 'Manøvrebane', 'Glatbane', 'Førstehjælpskursus', 'Teori- og køreprøve booking'],
    anbefalet: true,
  },
  {
    navn: 'Flex',
    pris: '14.495',
    beskrivelse: 'Til dig, der vil have maksimal fleksibilitet og ekstra timer.',
    features: ['Lovpligtig teori (29 lektioner)', '16 køretimer', 'Manøvrebane', 'Glatbane', 'Førstehjælpskursus', '2 prøveforsøg inkluderet', 'Ekstra teorihjælp'],
    anbefalet: false,
  },
];

const faq = [
  {
    q: 'Hvad koster et kørekort i alt?',
    a: 'Vores pakker starter ved 8.995 kr. Hertil kommer lovpligtige gebyrer til prøver og lægeattest (ca. 2.500-3.000 kr.). Se fuld prisoversigt på priser-siden.',
  },
  {
    q: 'Kan jeg booke online?',
    a: 'Ja. Du kan booke både teorihold og køretimer direkte på vores hjemmeside — uden at ringe.',
  },
  {
    q: 'Hvad hvis jeg skal aflyse?',
    a: 'Du kan aflyse eller flytte din køretime op til 24 timer før. Se vores afbudsregler på booking-siden.',
  },
  {
    q: 'Hvor lang tid tager det at få kørekort?',
    a: 'De fleste elever bruger 3-6 måneder, afhængigt af hvor ofte du kører og tager teori.',
  },
  {
    q: 'Har I automatgear?',
    a: 'Ja, vi har både automatgear og manuelt gear. Vælg det, der passer dig.',
  },
  {
    q: 'Hvordan betaler jeg?',
    a: 'Du kan betale med MobilePay, bankoverførsel eller i rater. Kontakt os for en aftale.',
  },
];
---

<Layout title="Køreskole i Randers · IC Køreskole">
  <Nav />

  <!-- HERO -->
  <section class="relative overflow-hidden flex flex-col min-h-[850px] md:min-h-[700px]">
    <div class="absolute inset-0">
      <img
        src="/images/hero.webp"
        alt=""
        class="w-full h-full object-cover object-[75%_bottom] md:object-right"
        aria-hidden="true"
        width="2014"
        height="780"
      />
      <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white via-white/80 to-transparent"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-6 pt-16 md:pt-24 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[var(--color-brand-500)] mb-6">
        Tag kørekortet i Randers — uden stress
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-ink-700)] mb-8 max-w-2xl mx-auto">
        Book online på 60 sekunder. Gennemsigtige priser. Fast instruktør hele forløbet.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mb-6">
        <a href="/priser" class="btn btn-brand">Se priser</a>
        <a href="/hold" class="btn btn-brand">Holdstart</a>
      </div>
    </div>

    <div class="relative mt-auto pb-8 text-center">
      <p class="text-sm text-[var(--color-ink-700)] inline-block bg-white/80 backdrop-blur px-4 py-2 rounded-full">
        ★★★★★ 4,9/5 baseret på 87 anmeldelser · 120+ elever bestået
      </p>
    </div>
  </section>

  <!-- USP'ER -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="text-4xl mb-4">⚡</div>
        <h2 class="text-xl font-bold mb-3">Book online på 60 sekunder</h2>
        <p class="text-[var(--color-ink-700)]">
          Vælg tid, få bekræftelse med det samme. Ingen telefonopkald, ingen ventetid.
        </p>
      </div>
      <div class="text-center">
        <div class="text-4xl mb-4">💰</div>
        <h2 class="text-xl font-bold mb-3">Ingen skjulte gebyrer</h2>
        <p class="text-[var(--color-ink-700)]">
          Se præcis hvad du betaler, før du starter. Alle priser er synlige fra dag ét.
        </p>
      </div>
      <div class="text-center">
        <div class="text-4xl mb-4">🎯</div>
        <h2 class="text-xl font-bold mb-3">Fast instruktør hele forløbet</h2>
        <p class="text-[var(--color-ink-700)]">
          Ingen skift, ingen forvirring. Du kører med samme instruktør fra første til sidste time.
        </p>
      </div>
    </div>
  </section>

  <!-- SÅDAN FOREGÅR DET -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
        Sådan foregår det
      </h2>
      <div class="grid md:grid-cols-4 gap-6">
        {[
          { n: '1', t: 'Tilmeld dig', d: 'Vælg et teorihold eller book din første køretime direkte online.' },
          { n: '2', t: 'Teori', d: 'Du gennemfører teorikurset — enten online eller fremmøde. Vi hjælper hele vejen.' },
          { n: '3', t: 'Kør', d: 'Fast instruktør, fleksible tider. Vi tilpasser forløbet til dig, ikke omvendt.' },
          { n: '4', t: 'Bestå', d: 'Vi følger dig helt til køreprøven — og til du står med kortet i hånden.' },
        ].map((step) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm">
            <div class="w-10 h-10 rounded-full bg-[var(--color-accent-500)] text-white font-bold flex items-center justify-center mb-4">
              {step.n}
            </div>
            <h3 class="font-bold text-lg mb-2">{step.t}</h3>
            <p class="text-sm text-[var(--color-ink-700)]">{step.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NÆSTE LEDIGE HOLD -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-4 text-[var(--color-brand-500)]">
      Næste ledige hold
    </h2>
    <p class="text-center text-[var(--color-ink-700)] mb-12 max-w-xl mx-auto">
      Vælg det hold, der passer dig. Ledige pladser opdateres løbende.
    </p>
    <div class="grid md:grid-cols-3 gap-6">
      {hold.map((h) => (
        <div class="border-2 border-[var(--color-brand-500)] rounded-2xl p-6 hover:border-gray-200 transition flex flex-col">
          <p class="text-sm font-semibold text-[var(--color-brand-500)] mb-2">HOLD {h.id}</p>
          <h3 class="text-xl font-bold mb-4">{h.start}</h3>
          <p class="text-sm text-[var(--color-ink-700)] mb-2">Teori: {h.tid}</p>
          <p class="text-sm text-[var(--color-ink-700)] mb-6">
            Ledige pladser: <strong>{h.ledige} af {h.iAlt}</strong>
          </p>
          <a
            href="/hold"
            class:list={[
              'btn w-full text-sm py-2 mt-auto text-white',
              h.ledige === 0 && 'bg-red-500 hover:bg-red-600',
              h.ledige > 0 && h.ledige <= 4 && 'bg-orange-500 hover:bg-orange-600',
              h.ledige > 4 && 'bg-green-600 hover:bg-green-700',
            ]}
          >
            {h.ledige === 0 ? 'Fyldt — venteliste' : 'Tilmeld dig'}
          </a>
        </div>
      ))}
    </div>
    <div class="text-center mt-10">
      <a href="/hold" class="text-[var(--color-brand-500)] font-semibold hover:underline">
        Se alle hold →
      </a>
    </div>
  </section>

    <!-- PAKKER & PRISER -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-4 text-[var(--color-brand-500)]">
        Hvad indeholder lovpakken?
      </h2>
      <p class="text-center italic text-[var(--color-ink-700)] mb-12 max-w-2xl mx-auto">
        Alt du skal bruge for at tage kørekortet — samlet i én pakke.
      </p>

      <div class="bg-white border-2 border-[var(--color-brand-500)] rounded-2xl p-8 md:p-10">
        <p class="text-[var(--color-ink-900)] leading-relaxed mb-6">
          Lovpakken indeholder <strong>30 teorilektioner</strong>, <strong>17 kørelektioner</strong>, manøvrebane <strong>3 × 45 minutter</strong> og køreteknik <strong>4 × 45 minutter</strong>.
        </p>

        <p class="text-[var(--color-ink-900)] leading-relaxed mb-6">
          Adgang til digital teoriportal er inkluderet i 4 måneder. Eventuel ekstra kørelektion koster <strong>700 kr.</strong>
        </p>

        <p class="text-[var(--color-ink-900)] leading-relaxed mb-6">
          Priser på ferie-lynhold kan være højere og opkræves et depositum. Ved køb af enkelte moduler i stedet for pakken, er prisen <strong>4.500 kr. pr. modul</strong>. Der er 5 moduler i alt.
        </p>

        <p class="text-[var(--color-ink-900)] leading-relaxed mb-6">
          Alle oplyste priser er inklusiv moms og administrationsgebyr. Ingen skjulte ekstra omkostninger.
        </p>

        <!-- Pris-boks -->
        <div class="flex justify-between items-center py-5 my-8 border-t-2 border-b-2 border-[var(--color-brand-500)]">
          <span class="font-semibold text-lg">Lovpakke + leje af skolevogn til køreprøven</span>
          <span class="text-3xl font-extrabold text-[var(--color-brand-500)]">17.500 + 800,-</span>
        </div>

        <p class="text-sm text-[var(--color-ink-700)] leading-relaxed mb-6">
          Udover afregning til køreskolen har du omkostninger som prøvegebyr til Færdselsstyrelsen (1.600 kr.), lægeattest (ca. 500 kr.), færdselsrelateret førstehjælpskursus (ca. 600 kr.) og pasfoto (ca. 150 kr.).
        </p>

        <p class="text-sm text-[var(--color-ink-700)] italic mb-8">
          Vi assisterer med alt det praktiske, når du er startet.
        </p>

        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/hold" class="btn btn-brand text-base px-8 py-4">
            Tilmeld dig nu
          </a>
          <a href="/priser" class="btn btn-secondary text-base px-8 py-4">
            Se alle priser
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ELEVHISTORIER -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
      Hvad siger vores elever?
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      {[
        { citat: 'Jeg havde prøvet to andre køreskoler, men her følte jeg mig endelig tryg. Bookingen var super nem, og min instruktør var tålmodig hele vejen.', navn: 'Maja, 19 år' },
        { citat: 'Det bedste var, at jeg kunne booke køretimer online om aftenen, når jeg havde tid. Ingen telefonopkald, ingen ventetid.', navn: 'Kasper, 22 år' },
        { citat: 'Jeg var nervøs for teoriprøven, men fik ekstra hjælp uden ekstra regning. Bestod i første forsøg.', navn: 'Sofie, 24 år' },
      ].map((e) => (
        <blockquote class="bg-[var(--color-brand-50)] rounded-2xl p-6">
          <p class="text-[var(--color-ink-700)] italic mb-4">"{e.citat}"</p>
          <footer class="text-sm font-semibold text-[var(--color-brand-500)]">— {e.navn}</footer>
        </blockquote>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
        Ofte stillede spørgsmål
      </h2>
      <div class="space-y-3">
        {faq.map((item) => (
          <details class="bg-white rounded-xl p-5 group">
            <summary class="font-semibold cursor-pointer flex justify-between items-center">
              {item.q}
              <span class="text-[var(--color-accent-500)] group-open:rotate-45 transition text-2xl leading-none">+</span>
            </summary>
            <p class="mt-4 text-[var(--color-ink-700)] text-sm">{item.a}</p>
          </details>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/faq" class="text-[var(--color-brand-500)] font-semibold hover:underline">
          Se alle spørgsmål →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA-BÅND -->
  <section class="max-w-4xl mx-auto px-6 py-20 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-[var(--color-brand-500)]">
      Klar til at starte?
    </h2>
    <p class="text-lg text-[var(--color-ink-700)] mb-8">
      Tilmeld dig et hold online på 60 sekunder. Vi glæder os til at møde dig.
    </p>
    <a href="/hold" class="btn btn-brand text-lg px-8 py-4">
      Tilmeld dig nu
    </a>
  </section>

  <Footer />
</Layout>