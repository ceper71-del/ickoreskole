---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const instruktører = [
  {
    navn: 'Ismail Ceper',
    titel: 'Indehaver & instruktør',
    siden: '2015',
    citat: 'Jeg elsker at se eleverne vokse fra nervøse begyndere til trygge bilister. Det er derfor, jeg gør det her.',
    erfaring: '15 års erfaring',
    certificering: 'Certificeret af Færdselsstyrelsen',
  },
  {
    navn: 'Frits Khristensen',
    titel: 'Instruktør',
    siden: '2018',
    citat: 'En god køretime handler ikke bare om at køre. Det handler om at forstå trafikken og føle sig tryg.',
    erfaring: '8 års erfaring',
    certificering: 'Certificeret af Færdselsstyrelsen',
  },
  {
    navn: 'Navn Efternavn',
    titel: 'Instruktør',
    siden: '2020',
    citat: 'Jeg møder hver elev med tålmodighed. Alle lærer i deres eget tempo — og det er helt okay.',
    erfaring: '6 års erfaring',
    certificering: 'Certificeret af Færdselsstyrelsen',
  },
];

const værdier = [
  {
    ikon: '🛡️',
    titel: 'Tryghed',
    tekst: 'Du skal føle dig tryg bag rattet. Vi tager det i dit tempo og presser dig aldrig.',
  },
  {
    ikon: '💎',
    titel: 'Gennemsigtighed',
    tekst: 'Ingen skjulte gebyrer. Ingen overraskelser. Du ved præcis, hvad du betaler.',
  },
  {
    ikon: '❤️',
    titel: 'Personlighed',
    tekst: 'Fast instruktør hele forløbet. Vi kender dig, og vi følger dig hele vejen.',
  },
];

const tal = [
  { tal: '120+', tekst: 'Elever bestået' },
  { tal: '92%', tekst: 'Beståelsesprocent' },
  { tal: '10+', tekst: 'Års erfaring' },
  { tal: '4,9/5', tekst: 'Gennemsnitlig anmeldelse' },
];
---

<Layout title="Mød instruktørerne · IC Køreskole Randers">
  <Nav />

  <!-- HERO -->
  <section class="bg-gradient-to-b from-[var(--color-brand-50)] to-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-brand-500)] mb-6">
        Mød dine instruktører
      </h1>
      <p class="text-lg text-[var(--color-ink-700)] max-w-2xl mx-auto">
        Vi er et lille team af erfarne instruktører, der brænder for at lære dig at køre sikkert — og bestå første gang.
      </p>
    </div>
  </section>

  <!-- INSTRUKTØRER -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <h2 class="text-3xl font-extrabold mb-12 text-[var(--color-brand-500)]">
      Vores team
    </h2>
    <div class="grid md:grid-cols-3 gap-8">
      {instruktører.map((i) => (
        <article class="bg-white border-2 border-gray-100 rounded-2xl overflow-hidden hover:border-[var(--color-accent-500)] transition">
          <div class="aspect-square bg-[var(--color-brand-50)] flex items-center justify-center">
            <div class="text-6xl opacity-30">👤</div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-1">{i.navn}</h3>
            <p class="text-sm font-semibold text-[var(--color-accent-600)] mb-4">{i.titel}</p>
            <p class="text-sm text-[var(--color-ink-700)] italic mb-4">"{i.citat}"</p>
            <ul class="text-xs text-[var(--color-ink-500)] space-y-1">
              <li>✓ Instruktør siden {i.siden}</li>
              <li>✓ {i.erfaring}</li>
              <li>✓ {i.certificering}</li>
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- VÆRDIER -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
        Vores værdier
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {værdier.map((v) => (
          <div class="bg-white rounded-2xl p-8 text-center">
            <div class="text-5xl mb-4">{v.ikon}</div>
            <h3 class="text-xl font-bold mb-3">{v.titel}</h3>
            <p class="text-[var(--color-ink-700)]">{v.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SKOLEN I TAL -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
      IC Køreskole i tal
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {tal.map((t) => (
        <div class="text-center">
          <p class="text-4xl md:text-5xl font-extrabold text-[var(--color-accent-500)] mb-2">
            {t.tal}
          </p>
          <p class="text-sm text-[var(--color-ink-700)] font-medium">{t.tekst}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-[var(--color-brand-500)]">
        Vil du høre mere?
      </h2>
      <p class="text-lg text-[var(--color-ink-700)] mb-8 max-w-xl mx-auto">
        Book en uforpligtende snak, eller skriv til os. Vi svarer inden for 24 timer på hverdage.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/kontakt" class="btn btn-primary">Kontakt os</a>
        <a href="/booking" class="btn btn-secondary">Book køretime</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>