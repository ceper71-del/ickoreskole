<form
  name="tilmeld"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="bg-white rounded-2xl p-8 space-y-5"
>
  <input type="hidden" name="form-name" value="tilmeld" />

  <p style="display: none;">
    <label>Udfyld ikke dette felt: <input name="bot-field" /></label>
  </p>

  <div>
    <label for="navn" class="block text-sm font-semibold mb-2">Navn *</label>
    <input
      type="text"
      id="navn"
      name="navn"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-semibold mb-2">Email *</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    />
  </div>

  <div>
    <label for="telefon" class="block text-sm font-semibold mb-2">Telefon *</label>
    <input
      type="tel"
      id="telefon"
      name="telefon"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    />
  </div>

  <div>
    <label for="hold" class="block text-sm font-semibold mb-2">Ønsket hold *</label>
    <select
      id="hold"
      name="hold"
      required
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none bg-white"
    >
      <option value="">Vælg hold…</option>
      {hold.map((h) => (
        <option value={`Hold ${h.id} — ${h.start}`}>
          Hold {h.id} — {h.start} ({h.tid})
        </option>
      ))}
    </select>
  </div>

  <div>
    <label for="kommentar" class="block text-sm font-semibold mb-2">Kommentar (valgfrit)</label>
    <textarea
      id="kommentar"
      name="kommentar"
      rows="4"
      class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 focus:border-[var(--color-accent-500)] focus:outline-none"
    ></textarea>
  </div>

  <label class="flex items-start gap-3 text-sm">
    <input type="checkbox" name="samtykke" required class="mt-1" />
    <span class="text-[var(--color-ink-700)]">
      Jeg accepterer, at IC Køreskole må kontakte mig angående min tilmelding. Se
      <a href="#" class="underline">privatlivspolitik</a>.
    </span>
  </label>

  <button type="submit" class="btn btn-primary w-full text-base py-3">
    Send tilmelding
  </button>
</form>