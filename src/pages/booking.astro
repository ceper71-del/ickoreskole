---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const BUMPIX_URL = 'https://bumpix.net/en/444910?hideHeader=1';

const trin = [
  { n: '1', t: 'Vælg dato', d: 'Find en dag, der passer dig i kalenderen.' },
  { n: '2', t: 'Vælg tid', d: 'Se ledige tider og vælg den, du vil have.' },
  { n: '3', t: 'Bekræft', d: 'Udfyld dine oplysninger og få bekræftelse med det samme.' },
];

const faq = [
  {
    q: 'Kan jeg booke samme dag?',
    a: 'Ja, hvis der er ledige tider. Se kalenderen ovenfor.',
  },
  {
    q: 'Kan jeg booke flere timer ad gangen?',
    a: 'Ja. Vælg flere tider i kalenderen, eller book én ad gangen.',
  },
  {
    q: 'Hvad hvis jeg kommer for sent?',
    a: 'Vi venter 10 minutter. Kommer du senere, betragtes timen som afholdt.',
  },
  {
    q: 'Kan jeg aflyse?',
    a: 'Ja. Du kan aflyse eller flytte din køretime op til 24 timer før. Ved senere afbud opkræves det fulde beløb.',
  },
  {
    q: 'Hvor møder jeg op?',
    a: '[Adresse], 8900 Randers. Mød op 5 minutter før din tid.',
  },
];
---

<Layout title="Book køretime online · IC Køreskole">
  <Nav />

  <!-- HERO -->
  <section class="bg-gradient-to-b from-[var(--color-brand-50)] to-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-brand-500)] mb-6">
        Book din køretime online
      </h1>
      <p class="text-lg text-[var(--color-ink-700)] max-w-2xl mx-auto">
        Vælg en tid, der passer dig. Du får bekræftelse med det samme.
      </p>
    </div>
  </section>

  <!-- BUMPIX BOOKING -->
  <section class="max-w-4xl mx-auto px-6 pb-20">
    <div class="bg-white border-2 border-gray-100 rounded-2xl overflow-hidden shadow-sm">
      <iframe
        src={BUMPIX_URL}
        width="100%"
        height="800"
        frameborder="0"
        loading="lazy"
        title="Book køretime hos IC Køreskole"
        class="w-full block"
      ></iframe>
    </div>

    <p class="text-center text-xs text-[var(--color-ink-500)] mt-4">
      Kalenderen opdateres live. Tider opdateres automatisk, når de bookes.
    </p>
  </section>

  <!-- SÅDAN BOOKER DU -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
        Sådan booker du
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {trin.map((t) => (
          <div class="bg-white rounded-2xl p-6 text-center">
            <div class="w-12 h-12 mx-auto rounded-full bg-[var(--color-accent-500)] text-white font-bold flex items-center justify-center mb-4 text-lg">
              {t.n}
            </div>
            <h3 class="font-bold text-lg mb-2">{t.t}</h3>
            <p class="text-sm text-[var(--color-ink-700)]">{t.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRAKTISK INFO -->
  <section class="max-w-4xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
      Praktisk info
    </h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white border-2 border-gray-100 rounded-2xl p-6">
        <div class="text-3xl mb-3">⏰</div>
        <h3 class="font-bold mb-2">Afbudsregler</h3>
        <p class="text-sm text-[var(--color-ink-700)]">
          Aflys eller flyt op til 24 timer før. Ved senere afbud opkræves det fulde beløb.
        </p>
      </div>
      <div class="bg-white border-2 border-gray-100 rounded-2xl p-6">
        <div class="text-3xl mb-3">📍</div>
        <h3 class="font-bold mb-2">Mødested</h3>
        <p class="text-sm text-[var(--color-ink-700)]">
          [Adresse], 8900 Randers. Mød op 5 minutter før din tid.
        </p>
      </div>
      <div class="bg-white border-2 border-gray-100 rounded-2xl p-6">
        <div class="text-3xl mb-3">🎒</div>
        <h3 class="font-bold mb-2">Hvad skal du have med?</h3>
        <p class="text-sm text-[var(--color-ink-700)]">
          Kørekort eller billede-ID. Ved første time: lægeattest.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-center mb-10 text-[var(--color-brand-500)]">
        Ofte stillede spørgsmål om booking
      </h2>
      <div class="space-y-3">
        {faq.map((item) => (
          <details class="bg-white rounded-xl p-5 group">
            <summary class="font-semibold cursor-pointer flex justify-between items-center">
              {item.q}
              <span class="text-[var(--color-accent-500)] group-open:rotate-45 transition text-2xl leading-none">+</span>
            </summary>
            <p class="mt-4 text-[var(--color-ink-700)] text-sm">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>