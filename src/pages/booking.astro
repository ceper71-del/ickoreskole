---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const faq = [
  {
    q: 'Hvordan booker jeg en køretime?',
    a: 'Booking af køretimer foregår direkte med din instruktør — enten i bilen eller i klassen. Det gør det nemt og personligt.',
  },
  {
    q: 'Kan jeg booke online?',
    a: 'Ikke endnu. Vi arbejder på en online booking-løsning, men indtil da foregår al booking i bilen eller i klassen.',
  },
  {
    q: 'Hvad hvis jeg skal aflyse?',
    a: 'Kontakt din instruktør direkte. Du kan aflyse op til 24 timer før din køretime.',
  },
  {
    q: 'Hvor møder jeg op?',
    a: 'Vestergade 42, 8900 Randers. Mød op 5 minutter før din tid.',
  },
];
---

<Layout title="Køretimer · IC Køreskole">
  <Nav />

  <!-- HERO -->
  <section class="bg-gradient-to-b from-[var(--color-brand-50)] to-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-brand-500)] mb-6">
        Køretimer
      </h1>
      <p class="text-lg text-[var(--color-ink-700)] max-w-2xl mx-auto">
        Booking af køretimer foregår direkte med din instruktør — i bilen eller i klassen.
      </p>
    </div>
  </section>

  <!-- INFO -->
  <section class="max-w-4xl mx-auto px-6 pb-20">
    <div class="bg-white border-2 border-[var(--color-brand-500)] rounded-2xl p-8 md:p-12 text-center">
      <div class="text-5xl mb-4">📅</div>
      <h2 class="text-2xl font-extrabold text-[var(--color-brand-500)] mb-4">
        Sådan booker du
      </h2>
      <p class="text-[var(--color-ink-700)] max-w-xl mx-auto mb-8">
        Du booker din næste køretime direkte med din instruktør — når I er færdige med dagens tur, eller når du møder op til teori. Det er nemt, personligt og uden ventetid.
      </p>
      <div class="grid md:grid-cols-3 gap-6 mt-10">
        <div>
          <div class="text-3xl mb-3">🚗</div>
          <h3 class="font-bold mb-2">I bilen</h3>
          <p class="text-sm text-[var(--color-ink-700)]">
            Aftal næste køretime, når I afslutter dagens tur.
          </p>
        </div>
        <div>
          <div class="text-3xl mb-3">📚</div>
          <h3 class="font-bold mb-2">I klassen</h3>
          <p class="text-sm text-[var(--color-ink-700)]">
            Book din tid på tavlen, når du er til teori.
          </p>
        </div>
        <div>
          <div class="text-3xl mb-3">📞</div>
          <h3 class="font-bold mb-2">Over telefon</h3>
          <p class="text-sm text-[var(--color-ink-700)]">
            Ring til os på <a href="tel:+4527462746" class="text-[var(--color-brand-500)] font-semibold">+45 27 46 27 46</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRAKTISK INFO -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
        Praktisk info
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-6">
          <div class="text-3xl mb-3">⏰</div>
          <h3 class="font-bold mb-2">Afbudsregler</h3>
          <p class="text-sm text-[var(--color-ink-700)]">
            Aflys eller flyt op til 24 timer før. Ved senere afbud opkræves det fulde beløb.
          </p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-6">
          <div class="text-3xl mb-3">📍</div>
          <h3 class="font-bold mb-2">Mødested</h3>
          <p class="text-sm text-[var(--color-ink-700)]">
            Vestergade 42, 8900 Randers. Mød op 5 minutter før din tid.
          </p>
        </div>
        <div class="bg-white border-2 border-gray-100 rounded-2xl p-6">
          <div class="text-3xl mb-3">🎒</div>
          <h3 class="font-bold mb-2">Hvad skal du have med?</h3>
          <p class="text-sm text-[var(--color-ink-700)]">
            Kørekort eller billede-ID. Ved første time: lægeattest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-extrabold text-center mb-10 text-[var(--color-brand-500)]">
      Ofte stillede spørgsmål om booking
    </h2>
    <div class="space-y-3">
      {faq.map((item) => (
        <details class="bg-white border-2 border-gray-100 rounded-xl p-5 group">
          <summary class="font-semibold cursor-pointer flex justify-between items-center">
            {item.q}
            <span class="text-[var(--color-brand-500)] group-open:rotate-45 transition text-2xl leading-none">+</span>
          </summary>
          <p class="mt-4 text-[var(--color-ink-700)] text-sm">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-[var(--color-brand-500)]">
        Klar til at starte?
      </h2>
      <p class="text-lg text-[var(--color-ink-700)] mb-8 max-w-xl mx-auto">
        Tilmeld dig et hold — så starter vi dig op på teorien med det samme.
      </p>
      <a href="/hold" class="btn btn-brand text-lg px-8 py-4">
        Tilmeld dig nu
      </a>
    </div>
  </section>

  <Footer />
</Layout>