---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const inkluderet = [
  'Ubegrænset teori, inkl. evaluerende prøver',
  '17 køretimer',
  'Manøvrebane (3 lektioner)',
  'Glatbane (4 lektioner)',
  'Booking af teori- og køreprøve',
  'Adgang til digital teoriportal',
  'Ekstra teorihjælp efter behov',
];

const ekstraOmkostninger = [
  { navn: 'Leje af skolevogn til køreprøve', pris: '800 kr.' },
  { navn: 'Eventuelt ekstra køretimer', pris: '700 kr.' },
  { navn: 'Lægeerklæring', pris: 'ca. 600 kr.' },
  { navn: 'Pasfoto', pris: 'ca. 100 kr.' },
  { navn: 'Førstehjælpsbevis', pris: '600 kr.' },
  { navn: 'Prøvegebyr til Færdselsstyrelsen (teori + køreprøve)', pris: '1.600 kr.' },
];

const faq = [
  {
    q: 'Kan jeg betale i rater?',
    a: 'Ja. Vi tilbyder delbetaling uden renter. Kontakt os for at lave en aftale.',
  },
  {
    q: 'Er der skjulte gebyrer?',
    a: 'Nej. Alle priser er synlige på denne side. De eneste gebyrer ud over pakken er de lovpligtige prøvegebyrer.',
  },
  {
    q: 'Hvornår skal jeg betale?',
    a: 'Du betaler et depositum ved tilmelding, og resten fordeles over forløbet.',
  },
  {
    q: 'Kan jeg få refunderet, hvis jeg stopper?',
    a: 'Ja, hvis du stopper inden for de første 14 dage, refunderer vi det ubrugte beløb. Se handelsbetingelser.',
  },
];
---

<Layout title="Priser på kørekort i Randers · IC Køreskole">
  <Nav />

    <!-- HERO -->
  <section class="bg-gradient-to-b from-[var(--color-brand-50)] to-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--color-brand-500)] mb-6">
        Priser
      </h1>
      <p class="text-lg italic text-[var(--color-ink-700)] max-w-2xl mx-auto">
        Se hvad der er inkluderet, og hvad du skal være opmærksom på undervejs.
      </p>
    </div>
  </section>

  <!-- PAKKE + EKSTRA -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="grid md:grid-cols-2 gap-12">

      <!-- VENSTRE: PAKKEN -->
      <div>
        <h2 class="text-2xl font-extrabold mb-4 text-[var(--color-brand-500)]">
          Priser på kørekort til bil
        </h2>
        <p class="text-[var(--color-ink-700)] italic mb-6">
          Her er, hvad standardpakken indeholder, og hvad du får med fra start:
        </p>

        <ul class="space-y-3 mb-8">
          {inkluderet.map((i) => (
            <li class="flex items-start gap-3">
              <span class="text-[var(--color-success)] font-bold text-lg">✓</span>
              <span class="text-[var(--color-ink-900)]">{i}</span>
            </li>
          ))}
        </ul>

        <div class="flex justify-between items-center py-4 border-t-2 border-b-2 border-[var(--color-brand-500)] mb-6">
          <span class="font-semibold text-lg">Pris for lovpakken</span>
          <span class="text-3xl font-extrabold text-[var(--color-brand-500)]">17.500 kr.</span>
        </div>

        <p class="text-sm text-[var(--color-ink-500)]">
          Læs mere om priser, betaling og rammerne for dit forløb i vores
          <a href="#" class="underline">forretningsbetingelser</a>.
        </p>

        <div class="mt-8">
          <a href="/hold" class="btn btn-brand text-base px-8 py-4 w-full md:w-auto">
            Tilmeld dig nu
          </a>
        </div>
      </div>

      <!-- HØJRE: ANDRE OMKOSTNINGER -->
      <div>
        <h2 class="text-2xl font-extrabold mb-4 text-[var(--color-brand-500)]">
          Andre omkostninger
        </h2>
        <p class="text-[var(--color-ink-700)] italic mb-6">
          Udgifter ligger uden for selve pakkeprisen og afhænger af dit forløb.
        </p>

        <div class="space-y-3">
          {ekstraOmkostninger.map((e) => (
            <div class="flex justify-between items-baseline gap-2 pb-2 border-b border-dotted border-gray-300">
              <span class="text-[var(--color-ink-900)]">{e.navn}</span>
              <span class="font-semibold text-[var(--color-brand-500)] shrink-0">{e.pris}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- BETALING -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold text-center mb-12 text-[var(--color-brand-500)]">
        Sådan kan du betale
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { t: 'MobilePay', d: 'Hurtigt og nemt. Betal fra mobilen.' },
          { t: 'Bankoverførsel', d: 'Til større beløb. Sikker overførsel.' },
          { t: 'Delbetaling', d: 'Uden renter. Kontakt os for en aftale.' },
        ].map((b) => (
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-6 text-center">
            <h3 class="font-bold text-lg mb-2">{b.t}</h3>
            <p class="text-sm text-[var(--color-ink-700)]">{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-extrabold text-center mb-10 text-[var(--color-brand-500)]">
      Ofte stillede spørgsmål om betaling
    </h2>
    <div class="space-y-3">
      {faq.map((item) => (
        <details class="bg-white border-2 border-gray-100 rounded-xl p-5 group">
          <summary class="font-semibold cursor-pointer flex justify-between items-center">
            {item.q}
            <span class="text-[var(--color-brand-500)] group-open:rotate-45 transition text-2xl leading-none">+</span>
          </summary>
          <p class="mt-4 text-[var(--color-ink-700)] text-sm">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-brand-50)] py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-[var(--color-brand-500)]">
        Klar til at komme i gang?
      </h2>
      <p class="text-lg text-[var(--color-ink-700)] mb-8">
        Vælg et hold og tilmeld dig online på 2 minutter.
      </p>
      <a href="/hold" class="btn btn-brand text-lg px-8 py-4">
        Se ledige hold
      </a>
    </div>
  </section>

  <Footer />
</Layout>